---
import { Image } from "astro:assets";
const desktopId = import.meta.env.MUX_DESKTOP_PLAYBACK_ID;
const mobileId = import.meta.env.MUX_MOBILE_PLAYBACK_ID;

const mobileVideoUrl = `https://stream.mux.com/${mobileId}/highest.mp4`;
const desktopVideoUrl = `https://stream.mux.com/${desktopId}/highest.mp4`;

const thumbBase = `https://image.mux.com/${desktopId}/thumbnail.png?time=0&fit_mode=preserve`;
---

<>
    <Image
        src={thumbBase}
        width={1920}
        height={1080}
        sizes={"100vw"}
        widths={[640, 1280, 1920]}
        quality={35}
        format="avif"
        alt={"Dolce Vita Luxury Real Estate"}
        fetchpriority="high"
        loading="eager"
        class="hero-poster absolute inset-0 w-full h-full object-cover"
        id="hero-poster"
    />

    <!-- Desktop Video -->
    <video
        id="hero-desktop"
        class="hero-video max-md:hidden absolute inset-0 w-full h-full object-cover"
        muted
        loop
        playsinline
        preload="none"
    >
        <source src={desktopVideoUrl} />
    </video>

    <!-- Mobile Video -->
    <video
        id="hero-mobile"
        class="hero-video md:hidden absolute inset-0 w-full h-full object-cover"
        muted
        loop
        playsinline
        preload="none"
    >
        <source src={mobileVideoUrl} />
    </video>
</>

<script>
    let currentVideo: HTMLVideoElement | null = null;

    function playCorrectVideo() {
        const isMobile = window.matchMedia("(max-width: 768px)").matches;
        const desktopVideo = document.getElementById(
            "hero-desktop",
        ) as HTMLVideoElement;
        const mobileVideo = document.getElementById(
            "hero-mobile",
        ) as HTMLVideoElement;

        const targetVideo = isMobile ? mobileVideo : desktopVideo;

        if (currentVideo === targetVideo) return;

        if (currentVideo) currentVideo.pause();

        if (targetVideo) {
            targetVideo.play().catch(() => {});
            targetVideo.classList.add("playing");
            currentVideo = targetVideo;
        }
    }

    const poster = document.getElementById("hero-poster") as HTMLImageElement;

    if (poster.complete) {
        playCorrectVideo();
    } else {
        poster.addEventListener("load", playCorrectVideo);
    }

    window.addEventListener("load", playCorrectVideo);

    const mediQuery = window.matchMedia("(max-width: 768px)");
    mediQuery.addEventListener("change", playCorrectVideo);
</script>
