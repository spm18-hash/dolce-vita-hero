---
import { CircleX, Phone, Mail } from "@lucide/astro";

import { Image } from "astro:assets";

import LondonPlace from "../assets/london.jpg";
import MarrakechPlace from "../assets/marrakech.jpg";

import WhatsAppIcon from "../assets/whatsapp.svg";
import InstagramIcon from "../assets/instagram.svg";
import TiktokIcon from "../assets/tiktok.svg";
import XIcon from "../assets/x.svg";
import YoutubeIcon from "../assets/youtube.svg";
import FacebookIcon from "../assets/facebook.svg";

const data = [
    "Home",
    "Buy",
    "Rent",
    "Services",
    "About",
    "Partners",
    "Contact",
    "News",
];
---

<div
    id="mobile-menu"
    class="overflow-y-auto fixed xl:flex-row-reverse xl:gap-14 2xl:p-14 2xl:justify-between p-4 md:p-6 inset-0 flex gap-6 flex-col bg-white text-black z-40 w-full h-dvh transition-transform duration-500 ease-in-out -translate-x-full data-open:translate-x-0 lg:max-w-9/12"
>
    <div class="w-full xl:max-w-xl flex flex-col gap-6">
        <button id="close-button" class="cursor-pointer self-end"
            ><CircleX size="52" stroke-width={0.75} /></button
        >
        <nav class="w-full flex flex-col items-center">
            <ul class="w-full flex flex-col xl:text-xl text-end">
                {
                    data.map((d) => (
                        <li class="border-b border-neutral-300 py-4 lg:py-5">
                            <a
                                href="/"
                                class="hover:text-amber-500 transition-colors"
                            >
                                {d}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <div
            class="flex flex-col lg:justify-end gap-3 lg:gap-6 lg:self-end py-4 lg:mt-auto lg:mb-10"
        >
            <span
                class="inline-block text-2xl md:text-3xl lg:text-4xl font-semibold font-italiana"
                >Follow us</span
            >

            <div class="flex items-center gap-4 [&_svg]:size-5">
                <div
                    class="size-10 rounded-full border flex items-center justify-center"
                >
                    <WhatsAppIcon />
                </div>
                <div
                    class="size-10 rounded-full border flex items-center justify-center"
                >
                    <FacebookIcon />
                </div>
                <div
                    class="size-10 rounded-full border flex items-center justify-center"
                >
                    <InstagramIcon />
                </div>
                <div
                    class="size-10 rounded-full border flex items-center justify-center"
                >
                    <XIcon />
                </div>
                <div
                    class="size-10 rounded-full border flex items-center justify-center"
                >
                    <TiktokIcon />
                </div>

                <div
                    class="size-10 rounded-full border flex items-center justify-center"
                >
                    <YoutubeIcon />
                </div>
            </div>
        </div>
    </div>

    <div class="space-y-12">
        <div class="space-y-6">
            <Image
                src={LondonPlace}
                alt="London"
                class="max-md:hidden"
                quality={50}
                format="avif"
                width={250}
                height={172}
            />
            <h3 class="text-2xl font-italiana">
                Dolce Vita | Luxury Real Estate London
            </h3>
            <div class="space-y-8 text-sm">
                <div class="ml-2 flex items-center gap-5">
                    <div
                        class="flex items-center justify-center relative before:absolute before:bg-black before:size-7 before:rotate-45"
                    >
                        <Phone size="18" stroke={"white"} class="relative" />
                    </div>
                    <span>+44 20 8870 5665</span>
                </div>

                <div class="ml-2 flex items-center gap-5">
                    <div
                        class="flex items-center justify-center relative before:absolute before:bg-black before:size-7 before:rotate-45"
                    >
                        <Mail size="18" stroke={"white"} class="relative" />
                    </div>
                    <span>contact@dolcevita.vip</span>
                </div>
            </div>
        </div>

        <div class="space-y-6">
            <Image
                src={MarrakechPlace}
                alt="London"
                class="max-md:hidden"
                quality={50}
                format="avif"
                width={250}
                height={172}
            />

            <h3 class="text-2xl font-italiana">
                Dolce Vita | Luxury Real Estate London
            </h3>
            <div class="space-y-8 text-sm">
                <div class="ml-2 flex items-center gap-5">
                    <div
                        class="flex items-center justify-center relative before:absolute before:bg-black before:size-7 before:rotate-45"
                    >
                        <Phone size="18" stroke={"white"} class="relative" />
                    </div>
                    <span>+44 20 8870 5665</span>
                </div>

                <div class="ml-2 flex items-center gap-5">
                    <div
                        class="flex items-center justify-center relative before:absolute before:bg-black before:size-7 before:rotate-45"
                    >
                        <Mail size="18" stroke={"white"} class="relative" />
                    </div>
                    <span>contact@dolcevita.vip</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    import { sidebar } from "../stores/sidebar-store";

    const closeButton = document.getElementById("close-button");

    if (closeButton) {
        closeButton.addEventListener("click", sidebar.close);
    }
</script>
