---
import { Square, SquareCheck } from "@lucide/astro";

interface Props {
    options: Options[];
    placeholder: string;
}

interface Options {
    value: string;
    label: string;
}

const { options, placeholder = "Select Categories" } = Astro.props;
---

<custom-select multiple class="relative block w-full font-sans">
    <button
        type="button"
        class="group w-full min-h-13 px-4 py-3 flex items-center justify-between bg-transparent border-b border-white text-white cursor-pointer transition-all duration-200 hover:border-neutral-600"
        aria-haspopup="listbox"
        aria-expanded="false"
        id="select-trigger"
    >
        <div
            id="selected-values"
            class="flex items-center gap-2 overflow-hidden whitespace-nowrap flex-nowrap flex-1"
        >
            <span class="text-white">{placeholder}</span>
        </div>
        <svg
            class="flex shrink-0 transition-transform duration-250 text-neutral-400 group-aria-expanded:rotate-180"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
        >
            <path
                d="M6 9L12 15L18 9"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
        </svg>
    </button>

    <div
        id="select-dropdown"
        class="absolute left-0 right-0 bg-white rounded-b-[10px] hidden z-100 max-h-80 overflow-y-auto py-1.5"
        role="listbox"
        aria-multiselectable="true"
    >
        {
            options.map((opt) => (
                <label
                    class:list={[
                        "select-option",
                        "group/option flex items-center gap-3 px-4 py-3 cursor-pointer select-none transition-colors duration-150 hover:bg-neutral-50 data-[active=true]:bg-green-50",
                    ]}
                    data-value={opt.value}
                >
                    <input type="checkbox" value={opt.value} class="hidden" />
                    <Square class="size-5 text-neutral-400 block group-data-[active=true]/option:hidden" />
                    <SquareCheck class="size-5 text-green-500 hidden group-data-[active=true]/option:block" />
                    <span class="text-sm text-neutral-800">{opt.label}</span>
                </label>
            ))
        }
    </div>
</custom-select>

<script>
    class CustomSelect extends HTMLElement {
        private trigger: HTMLButtonElement;
        private dropdown: HTMLDivElement;
        private selectedContainer: HTMLDivElement;
        private options: NodeListOf<HTMLElement>;
        private checkboxes: NodeListOf<HTMLInputElement>;
        private selected: string[] = [];
        private isOpen = false;

        constructor() {
            super();
            this.trigger =
                this.querySelector<HTMLButtonElement>("#select-trigger")!;
            this.dropdown =
                this.querySelector<HTMLDivElement>("#select-dropdown")!;
            this.selectedContainer =
                this.querySelector<HTMLDivElement>("#selected-values")!;
            this.options = this.querySelectorAll<HTMLElement>(".select-option");
            this.checkboxes = this.querySelectorAll<HTMLInputElement>(
                'input[type="checkbox"]',
            );
        }

        connectedCallback() {
            if (!this.trigger || !this.dropdown) return;

            // Toggle dropdown
            this.trigger.addEventListener("click", (e) => {
                e.stopPropagation();
                this.toggle();
            });

            // Main click handler on option
            this.options.forEach((option) => {
                option.addEventListener("click", (e) => {
                    e.stopPropagation();
                    const checkbox = option.querySelector<HTMLInputElement>(
                        'input[type="checkbox"]',
                    );
                    if (!checkbox) return;

                    // Toggle checkbox state
                    checkbox.checked = !checkbox.checked;

                    // Sync everything
                    this.syncState();
                });
            });

            // Also listen to direct checkbox changes (backup)
            this.checkboxes.forEach((cb) => {
                cb.addEventListener("change", () => this.syncState());
            });

            // Close when clicking outside
            document.addEventListener("click", (e) => {
                if (!this.contains(e.target as Node)) this.close();
            });

            // Keyboard support
            this.trigger.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    this.toggle();
                }
            });

            // Initialize from value attribute if exists
            const initial = this.getAttribute("value");
            if (initial) {
                try {
                    this.selected = JSON.parse(initial);
                    this.syncState(true);
                } catch (_) {}
            }
        }

        private syncState(fromInitial = false) {
            this.selected = Array.from(this.checkboxes)
                .filter((cb) => cb.checked)
                .map((cb) => cb.value);

            // Sync .active class with checkbox state
            this.options.forEach((option) => {
                const value = option.dataset.value;
                const checkbox = option.querySelector<HTMLInputElement>(
                    'input[type="checkbox"]',
                );
                const isActive = value ? this.selected.includes(value) : false;

                option.setAttribute("data-active", String(isActive));
                if (checkbox) checkbox.checked = isActive;
            });

            this.renderSelected();
            this.setAttribute("value", JSON.stringify(this.selected));

            this.dispatchEvent(
                new CustomEvent("change", {
                    detail: { value: [...this.selected] },
                    bubbles: true,
                }),
            );
        }

        toggle() {
            this.isOpen = !this.isOpen;
            this.dropdown.classList.toggle("hidden", !this.isOpen);
            this.trigger.setAttribute("aria-expanded", String(this.isOpen));
        }

        close() {
            this.isOpen = false;
            this.dropdown.classList.add("hidden");
            this.trigger.setAttribute("aria-expanded", "false");
        }

        renderSelected() {
            if (this.selected.length === 0) {
                this.selectedContainer.innerHTML = `<span class="text-white">Category</span>`;
                return;
            }

            const labels = this.selected
                .map((value) => {
                    const opt = [...this.options].find(
                        (o) => o.dataset.value === value,
                    );
                    return opt?.querySelector("span")?.textContent?.trim();
                })
                .filter(Boolean);

            this.selectedContainer.innerHTML = `<span class="selected-text text-white">${labels.join(", ")}</span>`;
        }

        // Public API
        get value() {
            return this.selected;
        }
        set value(values: string[]) {
            this.selected = values;
            this.syncState();
        }
    }

    customElements.define("custom-select", CustomSelect);
</script>

