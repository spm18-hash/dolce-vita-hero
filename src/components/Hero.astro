---
import Select from "./Select.svelte";
import Search from "../icons/search.svg";

import Video from "./Video.astro";
import Header from "./Header.astro";
import { countries, categories } from "../data/data";
---

<Header />

<main>
    <div class="relative w-full h-100 md:h-125 lg:h-150 xl:h-205">
        <Video />

        <div
            class="absolute inset-0 bg-linear-to-b from-black/10 via-black/20 to-black/40"
        >
        </div>
    </div>

    <div class="bg-[#000d19] h-200 px-6 pb-12 md:px-12 text-white">
        <div class="md:max-w-360 md:px-20 mx-auto pt-6">
            <div
                class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-4"
            >
                <Select
                    client:idle
                    placeholder="Category"
                    options={categories}
                />
                <Select client:idle placeholder="Country" options={countries} />

                <input
                    type="text"
                    placeholder="City"
                    class="w-full min-h-13 px-4 py-3 flex items-center justify-between bg-transparent border-b border-white text-white cursor-pointer transition-all duration-200 hover:border-neutral-600 placeholder:text-white"
                />
                <input
                    type="number"
                    placeholder="Area min"
                    class="w-full min-h-13 px-4 py-3 flex items-center justify-between bg-transparent border-b border-white text-white cursor-pointer transition-all duration-200 hover:border-neutral-600 placeholder:text-white"
                />
                <input
                    type="number"
                    placeholder="Price max"
                    class="w-full min-h-13 px-4 py-3 flex items-center justify-between bg-transparent border-b border-white text-white cursor-pointer transition-all duration-200 hover:border-neutral-600 placeholder:text-white"
                />
                <input
                    type="text"
                    placeholder="Reference"
                    class="w-full min-h-13 px-4 py-3 flex items-center justify-between bg-transparent border-b border-white text-white cursor-pointer transition-all duration-200 hover:border-neutral-600 placeholder:text-white"
                />

                <div class="flex items-end">
                    <button
                        class="bg-[#dd0426] transition-colors text-white font-medium px-7 py-3.5 flex items-center justify-center gap-2"
                    >
                        <span>Search</span>
                        <Search class="size-5" />
                    </button>
                </div>
            </div>
        </div>
    </div>
</main>
